diff --git a/codex-rs/code-mode-runtime/src/runtime/observation.rs b/codex-rs/code-mode-runtime/src/runtime/observation.rs
new file mode 100644
index 0000000..730dd72
--- /dev/null
+++ b/codex-rs/code-mode-runtime/src/runtime/observation.rs
@@ -0,0 +1,80 @@
+//! Experimental operator-owned callback journal. Never an authorization input.
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+use std::sync::atomic::{AtomicU64, Ordering};
+use serde_json::{Value, json};
+
+static NEXT_SCOPE: AtomicU64 = AtomicU64::new(1);
+static JOURNAL: OnceLock<Mutex<Option<File>>> = OnceLock::new();
+
+struct Bounded(Vec<u8>);
+impl Write for Bounded {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        if self.0.len() + bytes.len() > 65536 {
+            return Err(std::io::Error::other("observation argument limit"));
+        }
+        self.0.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+}
+
+fn emit(value: Value) {
+    let journal = JOURNAL.get_or_init(|| Mutex::new(
+        std::env::var_os("AEB_CALLBACK_JOURNAL").and_then(|path|
+            OpenOptions::new().write(true).create_new(true).open(path).ok())));
+    let Ok(mut journal) = journal.lock() else { return; };
+    if let Some(file) = journal.as_mut() {
+        if file.metadata().map_or(true, |meta| meta.len() > 8 * 1024 * 1024) {
+            *journal = None;
+            return;
+        }
+        // Any failed write leaves a partial record or missing scope closure.
+        // Consumers must reject either; logging never changes tool behavior.
+        let result = serde_json::to_writer(&mut *file, &value)
+            .and_then(|()| file.write_all(b"\n").map_err(serde_json::Error::io));
+        if result.is_err() { *journal = None; }
+    }
+}
+
+pub(super) struct Scope {
+    id: u64,
+    entered: u64,
+}
+impl Scope {
+    pub(super) fn new(outer: &str) -> Self {
+        if std::env::var_os("AEB_CALLBACK_JOURNAL").is_none() {
+            return Self { id: 0, entered: 0 };
+        }
+        let scope = Self { id: NEXT_SCOPE.fetch_add(1, Ordering::Relaxed), entered: 0 };
+        emit(json!({"stage":"scope_open", "scope":scope.id, "outer":outer}));
+        scope
+    }
+    pub(super) fn enter(&mut self, index: usize) -> u64 {
+        if self.id == 0 { return 0; }
+        self.entered += 1;
+        emit(json!({"stage":"callback_entered", "scope":self.id,
+            "callback":self.entered, "tool_index":index}));
+        self.entered
+    }
+    pub(super) fn serialized(&self, callback: u64, input: &Option<Value>) {
+        if self.id == 0 { return; }
+        let mut bytes = Bounded(Vec::new());
+        let complete = serde_json::to_writer(&mut bytes, input).is_ok();
+        let arguments = if complete { input.clone() } else { None };
+        emit(json!({"stage":"serialized", "scope":self.id, "callback":callback,
+            "arguments_complete":complete, "arguments":arguments}));
+    }
+    pub(super) fn queued(&self, callback: u64, runtime: &str) {
+        if self.id == 0 { return; }
+        emit(json!({"stage":"runtime_queued", "scope":self.id,
+            "callback":callback, "runtime_tool_call_id":runtime}));
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if self.id == 0 { return; }
+        emit(json!({"stage":"scope_closed", "scope":self.id, "callbacks":self.entered}));
+    }
+}
