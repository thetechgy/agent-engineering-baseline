+async def _bounded_compose_output(
+    process: asyncio.subprocess.Process,
+    *,
+    limit: int,
+    secret_values: set[str],
+) -> tuple[bytes, bytes]:
+    """Drain Compose output while retaining only a bounded, redacted terminal tail."""
+    marker = _STARTUP_TRUNCATION_MARKER.encode()
+    redaction = b"[REDACTED]"
+    if limit <= len(marker):
+        raise ValueError("Compose diagnostic byte limit must exceed the truncation marker")
+    if process.stdout is None:
+        raise RuntimeError("Compose diagnostic process has no stdout stream")
+    secret_bytes = sorted(
+        {
+            value.encode()
+            for value in secret_values
+            if value and len(value) >= _MIN_EXACT_SECRET_LENGTH
+        },
+        key=len,
+        reverse=True,
+    )
+    tail_limit = limit - len(marker)
+    overlap = max((len(value) - 1 for value in secret_bytes), default=0)
+    retained_limit = tail_limit + overlap
+    tail = bytearray()
+    total_bytes = 0
+    while chunk := await process.stdout.read(_STARTUP_DIAGNOSTIC_READ_CHUNK_BYTES):
+        total_bytes += len(chunk)
+        if len(chunk) >= retained_limit:
+            tail[:] = chunk[-retained_limit:]
+            continue
+        overflow = len(tail) + len(chunk) - retained_limit
+        if overflow > 0:
+            del tail[:overflow]
+        tail.extend(chunk)
+    await process.wait()
+
+    raw_tail = bytes(tail)
+    truncated = total_bytes > tail_limit
+    boundary = len(raw_tail) - tail_limit if truncated else 0
+    visible_tail = raw_tail[boundary:]
+    crossing_suffix = 0
+    if boundary:
+        for value in secret_bytes:
+            start = raw_tail.find(value)
+            while start >= 0:
+                end = start + len(value)
+                if start < boundary < end:
+                    crossing_suffix = max(crossing_suffix, end - boundary)
+                start = raw_tail.find(value, start + 1)
+    visible_tail = visible_tail[crossing_suffix:]
+    for value in secret_bytes:
+        visible_tail = visible_tail.replace(value, redaction)
+    if crossing_suffix:
+        available = tail_limit - len(redaction)
+        if available < 0:
+            visible_tail = b""
+        elif available == 0:
+            visible_tail = redaction
+        else:
+            visible_tail = redaction + visible_tail[-available:]
+    elif len(visible_tail) > tail_limit:
+        visible_tail = visible_tail[-tail_limit:]
+        truncated = True
+    return (marker if truncated else b"") + visible_tail, b""
+
+
+async def _compose_communication(
+    process: asyncio.subprocess.Process,
+    *,
+    stdin_bytes: bytes | None,
+    output_tail_bytes: int | None,
+    secret_values: set[str],
+) -> tuple[bytes, bytes]:
+    """Choose regular Compose collection or bounded diagnostic collection."""
+    if output_tail_bytes is None:
+        if stdin_bytes is not None:
+            return await process.communicate(stdin_bytes)
+        return await process.communicate()
+    if stdin_bytes is not None:
+        raise ValueError("Bounded Compose diagnostics do not accept stdin")
+    return await _bounded_compose_output(
+        process,
+        limit=output_tail_bytes,
+        secret_values=secret_values,
+    )
+
+
+def _format_startup_diagnostic(label: str, result: ExecResult) -> str:
+    """Describe one redacted, byte-bounded Compose diagnostic command."""
+    text = result.stdout if result.stdout else result.stderr
+    detail = " ".join(text.split()) if text else "(no output)"
+    return f"{label} (exit {result.return_code}): {detail}"
