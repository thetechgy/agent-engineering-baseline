 _MAIN_CONTAINER_STOP_TIMEOUT_SECONDS = 8
@@ -116,1 +120,17 @@ def _signal_process_tree(process: asyncio.subprocess.Process, value: signal.Signals) -> None:
+def _bounded_startup_diagnostic(value: str | None, limit: int) -> str:
+    """Return the diagnostic tail without allowing Compose output to dominate a failure."""
+    text = " ".join(value.split()) if value else ""
+    if not text:
+        return "(no output)"
+    if len(text) <= limit:
+        return text
+    return f"{_STARTUP_TRUNCATION_MARKER}{text[-(limit - len(_STARTUP_TRUNCATION_MARKER)):]}"
+
+
+def _format_startup_diagnostic(label: str, result: ExecResult, limit: int) -> str:
+    """Describe one redacted Compose diagnostic command."""
+    text = result.stdout if result.stdout else result.stderr
+    return f"{label} (exit {result.return_code}): {_bounded_startup_diagnostic(text, limit)}"
+
+
 def _signal_process_tree(process: asyncio.subprocess.Process, value: signal.Signals) -> None:
@@ -252,1 +272,28 @@ class SkillEvaluatorDockerEnvironment(DockerEnvironment):
