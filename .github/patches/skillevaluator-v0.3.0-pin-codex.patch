+        *,
+        env_overrides: Mapping[str, str] | None,
+        secret_values: set[str],
+    ) -> str:
+        """Collect bounded, redacted state before a failed Compose startup is cleaned up."""
+        diagnostics: list[str] = []
+        commands = (
+            ("service state", ["ps", "--all", "--format", "json"], _STARTUP_STATE_MAX_CHARS),
+            ("service logs", ["logs", "--no-color", "--tail", "100"], _STARTUP_LOG_MAX_CHARS),
+        )
+        for label, command, limit in commands:
+            try:
+                result = await self._run_docker_compose_command(
+                    command,
+                    check=False,
+                    timeout_sec=_STARTUP_DIAGNOSTIC_TIMEOUT_SECONDS,
+                    env_overrides=env_overrides,
+                    redact_values=secret_values,
+                )
+            except (OSError, RuntimeError):
+                diagnostics.append(f"{label}: unavailable")
+                continue
+            diagnostics.append(_format_startup_diagnostic(label, result, limit))
+        return " | ".join(diagnostics)
+
