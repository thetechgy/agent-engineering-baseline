+def validate_partial_oracle_rollups(payload, cases, ids, maximum):
+    """Reconcile the release's one-attempt oracle counts without inventing a rate."""
+    partial_fields = {'failed_cases', 'unresolved_cases', 'rate', 'rate_interval'}
+    require(maximum == 1 and set(cases) == set(ids)
+            and (partial_fields | {'passed_cases', 'attempts_used'}) <= payload.keys()
+            and payload['rate'] is None and payload['rate_interval'] is None,
+            'Invalid partial oracle rollup')
+    require(all(type(row.get('attempts_recovered')) is int and row['attempts_recovered'] == 0
+                and type(row.get('attempts')) is list and len(row['attempts']) <= 1
+                and type(row.get('passed')) is bool for row in cases.values()),
+            'Unexpected partial oracle attempts')
+    validate_summary_rollups({key: value for key, value in payload.items() if key not in partial_fields},
+                             cases, ids, maximum, False)
+    unresolved = sum(not row['attempts'] for row in cases.values())
+    failed = sum(bool(row['attempts']) and not row['passed'] for row in cases.values())
+    require(0 < unresolved < len(ids) and type(payload['failed_cases']) is int
+            and type(payload['unresolved_cases']) is int
+            and payload['failed_cases'] == failed and payload['unresolved_cases'] == unresolved,
+            'Partial oracle rollup count mismatch')
+
