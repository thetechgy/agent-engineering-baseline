+def _interrupted_trial_roots(job_dir: Path, expected_trials: int | None) -> list[Path] | None:
+    """Find finished trials backed by both the interrupted job and physical trial records."""
+    try:
+        from harbor.models.job.result import JobResult, JobStats
+        from harbor.models.trial.result import TrialResult
+
+        if _inspect_trial_directory(job_dir)[0] != "directory":
+            return None
+        job = JobResult.model_validate(_read_json(job_dir / "result.json"))
+        trials = job.trial_results
+        if job.n_total_trials != expected_trials or not 0 < len(trials) < job.n_total_trials:
+            return None
+        if len({trial.id for trial in trials}) != len(trials):
+            return None
+        recorded = {trial.trial_name: trial for trial in trials}
+        if len(recorded) != len(trials) or not all(trial.finished_at for trial in trials):
+            return None
+        derived = JobStats.from_trial_results(trials, n_total_trials=job.n_total_trials,
+                                             n_running_trials=job.stats.n_running_trials, n_retries=job.stats.n_retries)
+        if _trial_derived_job_stats(derived) != _trial_derived_job_stats(job.stats):
+            return None
+        matched = []
+        for path in sorted(job_dir.iterdir()):
+            kind, _ = _inspect_trial_directory(path)
+            if kind == "link":
+                return None
+            if kind != "directory":
+                continue
+            result_path = path / "result.json"
+            if not result_path.exists() and not result_path.is_symlink():
+                continue
+            trial = TrialResult.model_validate(_read_json(result_path))
+            if recorded.get(path.name) != trial:
+                return None
+            matched.append(path)
+        return matched if len(matched) == len(trials) else None
+    except (TypeError, ValueError, OSError):
+        return None


