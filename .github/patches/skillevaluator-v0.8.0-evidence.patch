diff --git a/src/skillevaluator/tier3/eval_core/sensitive_path_evidence.py b/src/skillevaluator/tier3/eval_core/sensitive_path_evidence.py
new file mode 100644
index 0000000..0ceb787
--- /dev/null
+++ b/src/skillevaluator/tier3/eval_core/sensitive_path_evidence.py
@@ -0,0 +1,137 @@
+"""Bounded classification of literal path evidence; never execute captured code.
+
+This is deliberately incomplete. Unknown syntax is not evidence of access or
+safety. Configuration contents and source literals are distinct from operands.
+"""
+import ast
+import re
+import shlex
+
+_SOCKET = re.compile(r"/(?:var/)?run/(?:user/(?:[0-9]+|\$\{?UID\}?)/)?podman/podman\.sock|/var/run/docker\.sock|/run/docker\.sock")
+
+
+def _sensitive(value, paths):
+    return any(path in value for path in paths) or bool(_SOCKET.search(value))
+
+
+def _python_literal_use(source, paths):
+    try:
+        tree = ast.parse(source)
+    except (SyntaxError, ValueError, RecursionError):
+        return "unknown"
+    if any(not isinstance(statement, (ast.Import, ast.Assign, ast.Expr, ast.Assert)) for statement in tree.body):
+        return "unknown"
+    if any(isinstance(node, ast.comprehension) for node in ast.walk(tree)):
+        return "unknown"
+    parents = {child: parent for parent in ast.walk(tree) for child in ast.iter_child_nodes(parent)}
+    # Dynamic interpretation can turn apparently inert source text into code.
+    if any(isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
+           and n.func.id in {"eval", "exec", "compile", "__import__"} for n in ast.walk(tree)):
+        return "unknown"
+    # Only the small configuration-inspection subset has known literal roles.
+    # User-defined equality, callbacks, imports and computed calls can reinterpret
+    # a comparison operand. Never turn those into a trusted textual reference.
+    for item in ast.walk(tree):
+        if isinstance(item, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda, ast.ImportFrom)):
+            return "unknown"
+        if isinstance(item, ast.Import) and any(alias.name not in {"yaml", "json"} or alias.asname not in {None, alias.name} for alias in item.names):
+            return "unknown"
+        if isinstance(item, (ast.Assign, ast.AnnAssign, ast.AugAssign, ast.NamedExpr)):
+            targets = item.targets if isinstance(item, ast.Assign) else [item.target]
+            if any(not isinstance(target, ast.Name) or target.id in {"open", "print", "yaml", "json"}
+                   for target in targets):
+                return "unknown"
+        if isinstance(item, ast.Call):
+            if isinstance(item.func, ast.Name) and item.func.id == "open" and (
+                not item.args or not isinstance(item.args[0], ast.Constant)
+                or not isinstance(item.args[0].value, str)
+            ):
+                return "unknown"
+            direct = isinstance(item.func, ast.Name) and item.func.id in {"open", "print"}
+            parser = (isinstance(item.func, ast.Attribute) and isinstance(item.func.value, ast.Name)
+                      and (item.func.value.id, item.func.attr) in {
+                          ("yaml", "safe_load"), ("json", "load"), ("json", "loads")})
+            file_read = (isinstance(item.func, ast.Attribute) and item.func.attr == "read"
+                         and isinstance(item.func.value, ast.Call)
+                         and isinstance(item.func.value.func, ast.Name) and item.func.value.func.id == "open")
+            if not (direct or parser or file_read):
+                return "unknown"
+    result = "text"
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Constant) or not isinstance(node.value, str) or not _sensitive(node.value, paths):
+            continue
+        parent = parents.get(node)
+        while isinstance(parent, (ast.List, ast.Tuple, ast.Set, ast.Dict)):
+            node, parent = parent, parents.get(parent)
+        if isinstance(parent, ast.Compare):
+            continue
+        if isinstance(parent, ast.Call) and isinstance(parent.func, ast.Name) and parent.func.id == "print":
+            continue
+        if isinstance(parent, ast.Call) and (
+            isinstance(parent.func, ast.Name) and parent.func.id == "open"
+            or isinstance(parent.func, ast.Attribute) and parent.func.attr in {"connect", "connect_ex"}
+        ):
+            return "access"
+        result = "unknown"
+    return result
+
+
+def classify_sensitive_command(source, paths):
+    """Return text, access, unknown, or absent for bounded literal evidence.
+
+    No result attests that an issued operation succeeded or was authorized.
+    """
+    if not isinstance(source, str) or len(source) > 65536:
+        return "unknown"
+    if not _sensitive(source, paths):
+        return "absent"
+    try:
+        lexer = shlex.shlex(source, posix=True, punctuation_chars=";&|<>()")
+        lexer.whitespace = " \t\r"
+        words = list(lexer)
+    except ValueError:
+        return "unknown"
+    # Unknown shell operators can launch another command or reinterpret data.
+    # Reject them before a leading echo/printf can hide subsequent operations.
+    if any(word and all(char in ";&|<>()" for char in word)
+           and word not in {";", "<", ">", ">>"} for word in words):
+        return "unknown"
+    commands, current = [], []
+    for word in words:
+        if word in {"\n", ";", "&&", "||", "|"}:
+            if current:
+                commands.append(current)
+            current = []
+        else:
+            current.append(word)
+    if current:
+        commands.append(current)
+    # Do not declare printed data inert if another command may interpret it.
+    if any(word in {"|", "&&", "||", "<<", "<<<"} for word in words) or any(
+        command[0].rsplit("/", 1)[-1] in {"sh", "bash", "dash", "eval", "source", "."}
+        for command in commands
+    ):
+        return "unknown"
+    result = "text"
+    for command in commands:
+        text = " ".join(command)
+        if not _sensitive(text, paths):
+            continue
+        executable = command[0].rsplit("/", 1)[-1]
+        if any(token in {"(", ")", "<<", "<<<"} or "$(" in token or "`" in token for token in command):
+            return "unknown"
+        if executable in {"python", "python3"} and len(command) == 3 and command[1] == "-c":
+            kind = _python_literal_use(command[2], paths)
+        elif executable in {"printf", "echo"}:
+            # Redirect destinations are actions, the printed body is data.
+            kind = "access" if any(command[i - 1] in {">", ">>", "<"} and _sensitive(token, paths)
+                                   for i, token in enumerate(command) if i) else "text"
+        elif executable in {"cat", "head", "tail", "nl", "stat", "ls", "curl", "wget", "podman", "docker", "mount"}:
+            kind = "access"
+        else:
+            kind = "unknown"
+        if kind == "access":
+            return kind
+        if kind == "unknown":
+            result = kind
+    return result
