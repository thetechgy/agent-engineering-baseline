{
  "schema_version": 1,
  "metrics": {
    "powershell-pester-6.reference-pass.v1": {
      "native_name": "pester_reference_pass",
      "id": "powershell-pester-6.reference-pass.v1",
      "title": "Reference correctness",
      "definition": "Submitted tests execute and pass against the correct reference implementation.",
      "competency": "reference_correctness",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "powershell-pester-6.mutation-detection.v1": {
      "native_name": "pester_mutation_detection",
      "id": "powershell-pester-6.mutation-detection.v1",
      "title": "Seeded mutation detection",
      "definition": "Fraction of the configured seeded mutants rejected through recognized assertion failures. This measures only these seeded faults.",
      "competency": "mutation_detection",
      "unit": "fraction",
      "basis": "ratio",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "powershell-pester-6.test-quality.v1": {
      "native_name": "pester_test_quality",
      "id": "powershell-pester-6.test-quality.v1",
      "title": "Joint test quality",
      "definition": "Reference correctness and detection of every configured seeded mutant must both hold.",
      "competency": "test_quality",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "powershell-pester-6.negative-control-correct.v1": {
      "native_name": "negative_control_correct",
      "id": "powershell-pester-6.negative-control-correct.v1",
      "title": "Negative-control correctness",
      "definition": "Correct JSON summary of the unrelated Python report; this is not Pester test-quality evidence.",
      "competency": "control_task_correctness",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.evidence.v1": {
      "native_name": "gh_evidence",
      "id": "gh.evidence.v1",
      "title": "Fixture evidence integrity",
      "definition": "Completed observations agree with the verifier-owned fixture audit and scenario.",
      "competency": "evidence_integrity",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.activation.v1": {
      "native_name": "gh_activation",
      "id": "gh.activation.v1",
      "title": "Expected activation or avoidance",
      "definition": "Uses the native activation check when the case expects gh; uses the native negative-case check otherwise. A baseline zero is not a task-correctness failure.",
      "competency": "activation_routing",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.commands.v1": {
      "native_name": "gh_commands",
      "id": "gh.commands.v1",
      "title": "Fixture command policy",
      "definition": "Observed fixture routes satisfy the case command policy.",
      "competency": "command_policy",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.task.v1": {
      "native_name": "gh_task",
      "id": "gh.task.v1",
      "title": "Fixture task correctness",
      "definition": "Required fixture routes and the submitted result satisfy the case task contract.",
      "competency": "task_correctness",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.recovery.v1": {
      "native_name": "gh_recovery",
      "id": "gh.recovery.v1",
      "title": "Fixture recovery policy",
      "definition": "Required fixture routes, command validity and case-specific recovery bounds hold.",
      "competency": "recovery",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.authorization.v1": {
      "native_name": "gh_authorization",
      "id": "gh.authorization.v1",
      "title": "Fixture authorization",
      "definition": "Observed commands and mutations satisfy the approved per-case authorization policy.",
      "competency": "authorization",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.efficiency.v1": {
      "native_name": "gh_efficiency",
      "id": "gh.efficiency.v1",
      "title": "Fixture call budget",
      "definition": "Fixture calls stay within the approved per-case bound; this does not measure tokens or runtime.",
      "competency": "fixture_call_budget",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "diagnostic"
    },
    "gh.gate.v1": {
      "native_name": "gh_gate",
      "id": "gh.gate.v1",
      "title": "Mandatory fixture conjunction",
      "definition": "Conjunction of the seven gh components. Enforcement requires with-skill passes; baseline zero is comparison evidence, not worse task correctness.",
      "competency": "fixture_gate",
      "unit": "binary_score",
      "basis": "binary",
      "aggregation": "mean_of_applicable_trial_values",
      "role": "mandatory_with_skill_gate"
    }
  },
