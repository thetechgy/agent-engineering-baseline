{
  "id": "gh-task-permission-v2",
  "definition": ".github/evals/campaigns/gh-task-permission-v2-live.json",
  "version": 1,
  "attempt_slots": 2,
  "trials_per_arm": 1,
  "automatic_retries": 0,
  "replacements": 0,
  "concurrency": 1,
  "primary_outcome": "Operational and grading-coverage smoke check of the coherent task/deployment permission successor on existing gh-014",
  "separate_outcomes": [
    "task correctness",
    "read authorization",
    "skill access",
    "task failure",
    "unavailable grading",
    "CLI failure",
    "usage",
    "cleanup"
  ],
  "interpretation": "Two attempts cannot establish skill benefit. Legitimate measured task failures may proceed when all operational checkpoints pass. Absent activation-gate failure is separate from correctness and authorization.",
  "budget": {
    "estimate_usd": 2,
    "stop_estimate_usd": 3,
    "overshoot_reserve_usd": 3,
    "planning_allocation_usd": 6,
    "billing_limit_enforced": false,
    "pricing_verified": "2026-11-16",
    "pricing_source": "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
    "prices_per_million": {
      "input": 4,
      "cached_input": 0.4,
      "output": 20
    }
  },
  "stop_rules": [
    "estimated_usage_threshold",
    "unknown_usage",
    "execution_infrastructure_failure",
    "cleanup_failure",
    "missing_grading_evidence",
    "missing_usable_evidence",
    "unsupported_grading",
    "verifier_failure",
    "missing_native_observation",
    "unsupported_runtime_protocol",
    "security_or_identity_drift"
  ],
  "agent_seconds": 600,
  "launch_seconds": 1200,
  "cleanup_grace_seconds": 80,
  "protected_environment": "skill-benchmark",
  "authorized_live_attempts": 0,
  "grading": {
    "mode": "custom_only",
    "agent_attempts": 2,
    "verifier_runs": 2,
    "model_judge_calls": 0,
    "judgments": "deterministic; no model judgments",
    "production_history": false
  },
  "authorization_expires_at": "2026-11-20T23:59:59Z",
  "qualification_scenarios": [
    "complete",
    "interruption",
    "missing-evidence",
    "unsupported-runtime",
    "unsupported-grading",
    "threshold",
    "unknown-usage",
    "verifier-failure",
    "cleanup-failure"
  ]
}
